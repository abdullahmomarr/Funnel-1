# ---- Anthropic (powers the live Maya demo via /api/maya) ----
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-opus-4-8. The original HTML used claude-sonnet-4-6.
MAYA_MODEL=claude-opus-4-8

# ---- Stripe ----
# Server secret key (test mode: sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
# Publishable key exposed to the browser (test mode: pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
